# Local server port
PORT=3000

# Only needed to test the Xero integration's serverless functions locally
# via `vercel dev` (server.js, used by `npm start`, doesn't serve /api/*).
# Copy this file to .env and fill these in from Supabase (Project Settings ->
# API — same values already in public/config.js) and your Nango dashboard
# (Environment settings -> API Keys). Never commit the real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NANGO_SECRET_KEY=

# Only set this if your Nango dashboard names the Xero integration something
# other than the default "xero".
# NANGO_XERO_INTEGRATION_ID=xero
